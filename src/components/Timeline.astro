---
import resume from "../data/resume.json";
import { stripPlaceholders } from "../lib/text";
const { experience } = resume;
---

<ol class="relative space-y-10 border-l pl-6 sm:pl-8" style="border-color: var(--border)">
  {
    experience.map((company) => (
      <li class="relative">
        <span
          class="absolute -left-[calc(1.5rem+5px)] top-1.5 h-[9px] w-[9px] rounded-full ring-4 sm:-left-[calc(2rem+5px)]"
          style="background: var(--accent); --tw-ring-color: var(--bg)"
          aria-hidden="true"
        />

        <div class="flex flex-wrap items-baseline gap-x-3">
          <h3 class="text-lg font-semibold tracking-tight">{company.company}</h3>
          <span class="text-[13px]" style="color: var(--text-faint)">
            {company.location}
          </span>
        </div>
        {company.context && (
          <p class="mt-1 text-[13px] leading-relaxed" style="color: var(--text-faint)">
            {company.context}
          </p>
        )}

        <div class="mt-5 space-y-6">
          {company.roles.map((role) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h4 class="text-[15px] font-semibold">{role.title}</h4>
                <p class="text-[13px] tabular-nums" style="color: var(--text-muted)">
                  {role.start} – {role.end}
                  {role.current && (
                    <span
                      class="ml-2 rounded-full px-2 py-0.5 text-[11px] font-semibold"
                      style="background: var(--accent-soft); color: var(--accent)"
                    >
                      Current
                    </span>
                  )}
                </p>
              </div>
              <ul class="mt-3 space-y-2">
                {role.bullets.map((b) => (
                  <li
                    class="relative pl-5 text-[14.5px] leading-relaxed"
                    style="color: var(--text-muted)"
                  >
                    <span
                      class="absolute left-0 top-[0.62em] h-[5px] w-[5px] rounded-full"
                      style="background: var(--border-strong)"
                      aria-hidden="true"
                    />
                    {stripPlaceholders(b)}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </li>
    ))
  }
</ol>
