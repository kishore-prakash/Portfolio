---
import resume from "../data/resume.json";
const { basics } = resume;

const socials = [
  { href: basics.linkedin, label: "LinkedIn" },
  { href: basics.github, label: "GitHub" },
  { href: basics.stackoverflow, label: "Stack Overflow" },
  { href: basics.stotramaala, label: "Stotramaala" },
];
const year = new Date().getFullYear();
---

<footer id="contact" class="scroll-mt-20 border-t py-16" style="border-color: var(--border)">
  <div class="container-page">
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Get in touch</h2>
        <p class="mt-3 max-w-md text-[15px] leading-relaxed" style="color: var(--text-muted)">
          Open to conversations about mobile leadership, iOS architecture and SDK work.
        </p>
        <div class="mt-6 space-y-2 text-[15px]">
          <p>
            <a
              href={`mailto:${basics.email}`}
              class="inline-flex min-h-11 items-center font-medium underline-offset-4 hover:underline"
            >
              {basics.email}
            </a>
          </p>
          <p>
            <a
              href={`tel:${basics.phone.replace(/\s/g, "")}`}
              class="inline-flex min-h-11 items-center font-medium underline-offset-4 hover:underline"
            >
              {basics.phone}
            </a>
          </p>
          <p style="color: var(--text-faint)">{basics.location}</p>
        </div>
      </div>

      <div class="sm:justify-self-end">
        <h3 class="text-xs font-semibold uppercase tracking-[0.14em]" style="color: var(--text-faint)">
          Elsewhere
        </h3>
        <ul class="mt-4 space-y-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center text-[15px] font-medium underline-offset-4 hover:underline"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-12 text-[13px]" style="color: var(--text-faint)">
      © {year} {basics.name}. Built with Astro.
    </p>
  </div>
</footer>
