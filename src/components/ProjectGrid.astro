---
import resume from "../data/resume.json";
import { withBase } from "../lib/base";

const CATEGORIES = [
  { key: "all", label: "All" },
  { key: "enterprise", label: "Enterprise apps" },
  { key: "sdk", label: "SDKs & frameworks" },
  { key: "nfc", label: "NFC apps" },
  { key: "personal", label: "My own apps" },
];

// Featured work first, then the rest in data order.
const projects = [...resume.projects].sort(
  (a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)),
);

const iconFor = (p: (typeof projects)[number]) =>
  "appId" in p
    ? withBase(`/img/apps/${p.slug}.jpg`)
    : withBase((p as { image?: string }).image ?? "");

const counts = Object.fromEntries(
  CATEGORIES.map((c) => [
    c.key,
    c.key === "all" ? projects.length : projects.filter((p) => p.category === c.key).length,
  ]),
);
---

<div
  class="mb-8 flex flex-wrap gap-2"
  role="group"
  aria-label="Filter projects by type"
  id="project-filters"
>
  {
    CATEGORIES.map((c, i) => (
      <button
        type="button"
        data-filter={c.key}
        aria-pressed={i === 0 ? "true" : "false"}
        class="filter-chip inline-flex min-h-11 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition-colors"
        style="border-color: var(--border-strong)"
      >
        {c.label}
        <span class="text-[12px] tabular-nums opacity-60">{counts[c.key]}</span>
      </button>
    ))
  }
</div>

<ul id="project-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    projects.map((p) => {
      const icon = iconFor(p);
      const link = (p as { link?: string }).link;
      const Tag = link ? "a" : "div";
      return (
        <li data-category={p.category}>
          <Tag
            {...(link ? { href: link, target: "_blank", rel: "noopener noreferrer" } : {})}
            class="surface group flex h-full flex-col rounded-xl p-5 transition-colors hover:border-[var(--border-strong)]"
          >
            <div class="flex items-start gap-3">
              {icon ? (
                <img
                  src={icon}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 shrink-0 rounded-[11px] object-cover"
                  style="border: 1px solid var(--border)"
                />
              ) : (
                <span
                  class="grid h-12 w-12 shrink-0 place-items-center rounded-[11px] text-base font-semibold"
                  style="background: var(--accent-soft); color: var(--accent)"
                  aria-hidden="true"
                >
                  {p.name.slice(0, 2)}
                </span>
              )}

              <div class="min-w-0 flex-1">
                <h3 class="text-[15px] font-semibold leading-snug">
                  {p.name}
                  {link && (
                    <svg
                      class="ml-1 inline-block h-3.5 w-3.5 -translate-y-px opacity-0 transition-opacity group-hover:opacity-60"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </h3>
                <p class="mt-0.5 text-[12.5px]" style="color: var(--text-faint)">
                  {[(p as { org?: string }).org, p.years].filter(Boolean).join(" · ")}
                </p>
              </div>
            </div>

            <p class="mt-3 flex-1 text-[13.5px] leading-relaxed" style="color: var(--text-muted)">
              {p.blurb}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.tech.slice(0, 4).map((t) => (
                <span
                  class="rounded-md px-2 py-1 text-[11.5px] font-medium"
                  style="background: var(--bg-subtle); color: var(--text-faint)"
                >
                  {t}
                </span>
              ))}
            </div>

            <p class="mt-3 text-[11.5px]" style="color: var(--text-faint)">
              Team of {p.teamSize}
              {(p as { delisted?: boolean }).delisted && " · no longer on the App Store"}
            </p>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .filter-chip[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-on);
    border-color: var(--accent);
  }
  .filter-chip[aria-pressed="false"]:hover {
    background: var(--bg-subtle);
  }
</style>

<script is:inline>
  (function () {
    var filters = document.getElementById("project-filters");
    var items = Array.prototype.slice.call(
      document.querySelectorAll("#project-list > li"),
    );

    filters.addEventListener("click", function (e) {
      var btn = e.target.closest(".filter-chip");
      if (!btn) return;
      var key = btn.dataset.filter;

      filters.querySelectorAll(".filter-chip").forEach(function (b) {
        b.setAttribute("aria-pressed", String(b === btn));
      });

      items.forEach(function (li) {
        li.hidden = key !== "all" && li.dataset.category !== key;
      });
    });
  })();
</script>
